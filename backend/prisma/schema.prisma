generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Property {
  id          Int    @id @default(autoincrement())
  name        String
  type        String // "condo" | "house" | "townhouse" | "villa"
  description String? @db.Text // Human-readable description shown in detail view

  // Location
  location    String  // Human-readable address / area label
  district    String  // Bangkok เขต — used to match Quiz Step 1 dropdown (e.g. "วัฒนา")
  locationLat Float
  locationLng Float

  // Media — first image URL (quick access), full gallery as JSON array
  imageUrl    String?           // primary thumbnail
  images      Json?             // ["url1","url2",...] for carousel

  price   Int
  sizeSqm Float

  // Facilities
  isPetFriendly      Boolean @default(false)
  hasUniversalDesign Boolean @default(false)
  hasPetPark         Boolean @default(false)
  hasParking         Boolean @default(false)
  hasElevator        Boolean @default(false)

  // Environmental
  pm25       Float  // µg/m³
  noiseLevel Float  // dB (0–100)

  // Character
  securityLevel  String // "low" | "medium" | "high"
  communityStyle String // "urban" | "suburban" | "resort" | "quiet" | "mixed"

  // Proximity distances in meters
  // JSON: { hospital, vet, gym, cafe, school, greenSpace, commuteStation, shopping }
  nearPlaces Json

  // Pre-calculated travel time to key Bangkok work zones (minutes)
  // JSON: { "สีลม / สาทร": 20, "สุขุมวิท": 10, "อโศก": 8, ... }
  workplaceCommuteMins Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
